{
  "name": "disclosure-report",
  "version": "1.0.0",
  "description": "Disclosure Report — a bug-bounty vulnerability report kit (PDF + delivery email) built with Hyper Elements. Sample data is fictional.",
  "main": "index.js",
  "scripts": {
    "build": "tsx scripts/build.tsx",
    "check": "npx hyper-elements check src/report.tsx src/email.tsx",
